<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие стили окон ARV. Подключаются только в ресурсы собственных окон. -->
    <SolidColorBrush x:Key="Arv.Accent" Color="#57007F"/>
    <SolidColorBrush x:Key="Arv.AccentHover" Color="#6C188F"/>
    <SolidColorBrush x:Key="Arv.AccentPressed" Color="#430061"/>
    <SolidColorBrush x:Key="Arv.AccentLight" Color="#F0E8F5"/>
    <SolidColorBrush x:Key="Arv.Focus" Color="#A66DC0"/>
    <SolidColorBrush x:Key="Arv.Background" Color="#F7F6F9"/>
    <SolidColorBrush x:Key="Arv.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Arv.Border" Color="#DDD8E4"/>
    <SolidColorBrush x:Key="Arv.Text" Color="#25202A"/>
    <SolidColorBrush x:Key="Arv.TextSecondary" Color="#6A626F"/>
    <SolidColorBrush x:Key="Arv.DisabledBackground" Color="#EEEBF0"/>
    <SolidColorBrush x:Key="Arv.DisabledText" Color="#8A8490"/>
    <SolidColorBrush x:Key="Arv.Error" Color="#B42318"/>
    <SolidColorBrush x:Key="Arv.Warning" Color="#8C5A00"/>
    <SolidColorBrush x:Key="Arv.WarningBackground" Color="#FFF7E0"/>
    <SolidColorBrush x:Key="Arv.Success" Color="#276749"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#57007F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0E8F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#57007F"/>
    <Style x:Key="Arv.DialogWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="Background" Value="{StaticResource Arv.Background}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
    </Style>
    <Style x:Key="Arv.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style x:Key="Arv.SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style x:Key="Arv.HelpText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Arv.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style x:Key="Arv.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Arv.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Arv.TextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Arv.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Arv.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Arv.DisabledBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource Arv.DisabledText}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Arv.Error}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Arv.ComboBox" TargetType="ComboBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="Background" Value="{StaticResource Arv.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style x:Key="Arv.Button" TargetType="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource Arv.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Frame" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="6" BorderBrush="{StaticResource Arv.Focus}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Arv.AccentLight}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#E6D9EF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Arv.DisabledBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Arv.DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Arv.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Arv.Button}">
        <Setter Property="Background" Value="{StaticResource Arv.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Arv.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Arv.AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Arv.DisabledBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource Arv.DisabledText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Arv.DataGrid" TargetType="DataGrid">
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderHeight" Value="32"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEEAF2"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FBFAFC"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="{StaticResource Arv.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Arv.Accent}"/>
                <Setter Property="Background" Value="{StaticResource Arv.AccentLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Arv.TextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Arv.ComboBox}">
        <Setter Property="ToolTip" Value="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Arv.Button}"/>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4,0,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="0,4,0,8"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Arv.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="Arv.InputLabel" TargetType="Label">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{StaticResource Arv.Text}"/>
    </Style>
</ResourceDictionary>
