<Window x:Class="MyPlugin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Container" Height="550" Width="550"
        MaxHeight="700" MaxWidth="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Категория -->
        <Label Grid.Row="0" Grid.Column="0" Content="Категория:" Margin="0,5,5,5"/>
        <ComboBox x:Name="comboBoxCategories" Grid.Row="0" Grid.Column="1" Margin="0,5"
                  SelectionChanged="ComboBoxCategories_SelectionChanged"/>

        <!-- Семейства -->
        <Label Grid.Row="1" Grid.Column="0" Content="Семейства:" VerticalAlignment="Top" Margin="0,5,5,5"/>
        <ListBox x:Name="listBoxFamilies" Grid.Row="1" Grid.Column="1" Margin="0,5"
                 SelectionMode="Extended"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 MinHeight="100">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки выбора -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5">
            <Button Content="Выбрать все" Width="100" Margin="0,0,5,0" Click="SelectAll_Click"/>
            <Button Content="Снять выделение" Width="120" Click="DeselectAll_Click"/>
        </StackPanel>

        <!-- Параметры сетки -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Шаг X:" Margin="0,0,5,0"/>
            <TextBox x:Name="textBoxStepX" Grid.Row="0" Grid.Column="1" Text="10" Margin="0,0,10,0"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Кол-во X:" Margin="0,0,5,0"/>
            <TextBox x:Name="textBoxCountX" Grid.Row="0" Grid.Column="3" Text="5" Margin="0,0,10,0"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Шаг Y:" Margin="0,5,5,0"/>
            <TextBox x:Name="textBoxStepY" Grid.Row="1" Grid.Column="1" Text="10" Margin="0,5,10,0"/>
            <Label Grid.Row="1" Grid.Column="2" Content="Кол-во Y (авто):" Margin="0,5,5,0"/>
            <Label x:Name="lblCountY" Grid.Row="1" Grid.Column="3" Content="0" Margin="0,5,10,0" FontWeight="Bold"/>
        </Grid>

        <!-- Индикатор прогресса -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <ProgressBar x:Name="progressBar" Height="20" Visibility="Collapsed" IsIndeterminate="True"/>
            <Label x:Name="lblStatus" Content="" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Кнопка создания -->
        <Button Grid.Row="5" Grid.ColumnSpan="2" Content="Создать" Width="100" Height="30"
                HorizontalAlignment="Center" VerticalAlignment="Center" Click="CreateButton_Click"/>
    </Grid>
</Window>