<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ARV.ElementViews.MainWindow" Title="ARV — Создать виды элемента" Width="1180" Height="710" MinWidth="440" MinHeight="300" WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ElementViews;component/Common/ArvTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="24,16,24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Image Source="/ElementViews;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
<StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Создать виды элемента" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/><TextBlock x:Name="ContextText" Text="Настройте виды, названия и листы для выбранных элементов." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Button Content="Загрузить…" Style="{StaticResource Arv.Button}" Click="Load_Click"/><Button Content="Сохранить…" Style="{StaticResource Arv.Button}" Margin="8,0,0,0" Click="Save_Click"/></StackPanel><TextBlock x:Name="FileStatusText" Style="{StaticResource Arv.HelpText}" Margin="0,4,0,0"/></StackPanel></Grid>
<ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="24,0,24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox x:Name="UniqueCheckBox" VerticalAlignment="Center" Click="PreviewChanged" Margin="0,0,12,0"><TextBlock Text="Один экземпляр на заполненное значение параметра"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=UniqueCheckBox}" Value="False"><Setter Property="Foreground" Value="#8A8490"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></CheckBox>
<ComboBox Grid.Column="1" Width="280" HorizontalAlignment="Left" x:Name="ParameterComboBox" Style="{StaticResource Arv.ComboBox}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" IsEnabled="{Binding IsChecked,ElementName=UniqueCheckBox}" SelectionChanged="ParameterChanged" ToolTip="Введите начало названия параметра или выберите его из списка." Margin="0,0,12,0"/>
<StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Тип сечения" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="SectionTypeComboBox" Width="170" Style="{StaticResource Arv.ComboBox}"/></StackPanel></Grid>
<TextBlock x:Name="CountInfo" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TabControl x:Name="SettingsTabs" BorderBrush="{StaticResource Arv.Border}" Background="White"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="14,6"/><Setter Property="Foreground" Value="{StaticResource Arv.Accent}"/></Style></TabControl.Resources>
<TabItem Header="Виды"><StackPanel Margin="12">
<TextBlock Text="Шаблон задаёт масштаб. № вида используется в схеме листа. Пример названия — Пм-1." Style="{StaticResource Arv.HelpText}" Margin="0,0,0,8"/>
<DataGrid x:Name="ViewsGrid" Height="242" Style="{StaticResource Arv.DataGrid}" IsReadOnly="False" RowHeight="28" ColumnHeaderHeight="44" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="TextBox" BasedOn="{StaticResource Arv.TextBox}"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="3,1"/><Setter Property="FontSize" Value="12"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource Arv.ComboBox}"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="3,1"/><Setter Property="FontSize" Value="12"/></Style></DataGrid.Resources><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="11"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="3,0"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.CellStyle>
<DataGrid.Columns>
<DataGridTemplateColumn Header="✓" Width="28" MinWidth="28"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="№" Binding="{Binding Number}" Width="28" MinWidth="28" IsReadOnly="True"/>
<DataGridTextColumn Header="Вид" Binding="{Binding Label}" Width="68" MinWidth="68" IsReadOnly="True"/>
<DataGridTemplateColumn Header="От низа, мм" Width="72" MinWidth="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding OffsetText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPlan}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Отступы до границ вида" Width="183" MinWidth="183"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><StackPanel><TextBlock Text="Отступы до границ вида" HorizontalAlignment="Center"/><UniformGrid Columns="3" Margin="0,4,0,0"><TextBlock Text="в стороны" HorizontalAlignment="Center"/><TextBlock Text="вверх" HorizontalAlignment="Center"/><TextBlock Text="вниз" HorizontalAlignment="Center"/></UniformGrid></StackPanel></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><UniformGrid Columns="3"><TextBox Text="{Binding SideText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="В стороны, мм"/><TextBox Text="{Binding AboveText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Вверх, мм"/><TextBox Text="{Binding BelowText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Вниз, мм"/></UniformGrid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Префикс вида" Width="150" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Prefix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Суффикс вида" Width="90" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Suffix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Суффикс заголовка" Width="135" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding TitleSuffix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Заголовок на листе = введённый текст + значение параметра. Пример: Разрез Пм-1"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Шаблон вида" Width="100" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Templates}" SelectedValuePath="Id" SelectedValue="{Binding TemplateId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" IsTextSearchEnabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Тип видового экрана" Width="100" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding ViewportTypes}" SelectedValuePath="Id" SelectedValue="{Binding ViewportTypeId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" IsTextSearchEnabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<TextBlock Text="{Binding SelectedItem.Preview,ElementName=ViewsGrid,StringFormat='Пример названия вида: {0}'}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
</StackPanel></TabItem>
<TabItem x:Name="SchedulesTab" Header="Спецификации"><StackPanel Margin="12">
<TextBlock Text="До 10 спецификаций. Поиск — по части названия. Без копирования исходная спецификация остаётся неизменной." Style="{StaticResource Arv.HelpText}" Margin="0,0,0,8"/>
<DataGrid x:Name="SchedulesGrid" Height="326" Style="{StaticResource Arv.DataGrid}" IsReadOnly="False" RowHeight="28" ColumnHeaderHeight="44" EnableRowVirtualization="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="ComboBox" BasedOn="{StaticResource Arv.ComboBox}"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="3,1"/><Setter Property="ToolTip" Value="{Binding SelectedItem,RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="11"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></DataGrid.ColumnHeaderStyle><DataGrid.Columns>
<DataGridTextColumn Header="№" Binding="{Binding Number}" Width="28" MinWidth="28" IsReadOnly="True"/>
<DataGridTemplateColumn Header="Название спецификации" Width="270" MinWidth="270"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AllSchedules}" SelectedItem="{Binding Source,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextBoxBase.TextChanged="ScheduleSearchChanged"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Копировать спецификацию" Width="96" MinWidth="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Copy,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCopy}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Изменить фильтр" Width="210" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" IsSynchronizedWithCurrentItem="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Условие фильтра" Width="150" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Operators}" SelectedValuePath="Key" SelectedValue="{Binding OperatorKey,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" IsSynchronizedWithCurrentItem="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Значение фильтра" Width="92" MinWidth="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FilterValue}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8A8490"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Параметр вида для марки" Width="200" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Parameters}" SelectedItem="{Binding ViewParameter,Mode=TwoWay}" IsEnabled="{Binding CanEdit}" IsSynchronizedWithCurrentItem="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Горизонтальный зазор столбцов, мм" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ScheduleGapTextBox" Text="10" Width="70" Style="{StaticResource Arv.TextBox}"/><Button Content="Заполнить схему спецификаций" Click="FillScheduleLayout_Click" Style="{StaticResource Arv.Button}" Margin="12,0,0,0"/></StackPanel>
<TextBlock Text="Расположение номеров 1–10 — на вкладке «Листы», справа на схеме. Копии получают имя исходной спецификации и марку элемента." Style="{StaticResource Arv.HelpText}" Margin="0,8,0,0"/>
</StackPanel></TabItem>
<TabItem x:Name="SheetsTab" Header="Листы"><StackPanel Margin="12">
<CheckBox x:Name="CreateSheetCheckBox" Content="Создавать лист для каждого элемента" FontWeight="SemiBold"/>
<Grid x:Name="SheetPanel" IsEnabled="{Binding IsChecked,ElementName=CreateSheetCheckBox}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="550"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,20,0">
<TextBlock Text="Семейство и тип основной надписи" Style="{StaticResource Arv.FieldLabel}"/><ComboBox x:Name="TitleBlockComboBox" Style="{StaticResource Arv.ComboBox}"/>
<StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Формат листа: А" VerticalAlignment="Center"/><TextBox x:Name="FormatATextBox" Width="52" Style="{StaticResource Arv.TextBox}" Margin="4,0" ToolTip="Значение параметра экземпляра «А» (кириллица) основной надписи. Пусто — оставить значение семейства."/><TextBlock Text="х" VerticalAlignment="Center"/><TextBox x:Name="FormatXTextBox" Width="52" Style="{StaticResource Arv.TextBox}" Margin="4,0" ToolTip="Значение параметра экземпляра «х» (кириллица) основной надписи. Пусто — оставить значение семейства."/></StackPanel>
<TextBlock Text="Префикс названия листа" Style="{StaticResource Arv.FieldLabel}" Margin="0,12,0,4"/><TextBox x:Name="SheetPrefixTextBox" Text="Элемент " Style="{StaticResource Arv.TextBox}" TextChanged="SheetNameChanged"/>
<TextBlock Text="Суффикс названия листа" Style="{StaticResource Arv.FieldLabel}" Margin="0,12,0,4"/><TextBox x:Name="SheetSuffixTextBox" Style="{StaticResource Arv.TextBox}" TextChanged="SheetNameChanged"/>
<TextBlock x:Name="SheetNamePreview" Style="{StaticResource Arv.HelpText}" Margin="0,8,0,0"/>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,8,0"><TextBlock Text="Слева, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetLeftTextBox" Text="20" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Сверху, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetTopTextBox" Text="20" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Зазор между видами, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetGapTextBox" Text="10" Style="{StaticResource Arv.TextBox}"/></StackPanel></Grid>
</StackPanel>
<StackPanel Grid.Column="1">
<CheckBox x:Name="UseLayoutCheckBox" Content="Размещать по схеме листа" Margin="0,0,0,8"/>
<StackPanel>
<StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked,ElementName=UseLayoutCheckBox}"><TextBlock Text="Строки" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LayoutRowsCombo" Width="52" SelectionChanged="LayoutSizeChanged"/><TextBlock Text="Столбцы" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="LayoutColumnsCombo" Width="52" SelectionChanged="LayoutSizeChanged"/><Button Content="Заполнить по порядку" Style="{StaticResource Arv.Button}" Click="FillLayout_Click" Margin="12,0,0,0"/></StackPanel>
<Border Background="#EEEAF2" Padding="8" Margin="0,8,0,0"><Border BorderBrush="#25202A" BorderThickness="2" Background="White" Height="210"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions>
<TextBlock Grid.Column="1" Text="{Binding Text,ElementName=SheetTopTextBox,StringFormat='↓ Сверху: {0} мм'}" Foreground="#57007F" FontSize="11" VerticalAlignment="Center"/>
<TextBlock Grid.Row="1" Text="{Binding Text,ElementName=SheetLeftTextBox,StringFormat='← Слева: {0} мм'}" Foreground="#57007F" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock>
<Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
<Grid Margin="0,28,0,0"><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Виды" FontSize="10" HorizontalAlignment="Center"/><Border Grid.Row="1" BorderBrush="#B597C4" BorderThickness="1,1,0,0"><Grid x:Name="LayoutGrid" Margin="3" IsEnabled="{Binding IsChecked,ElementName=UseLayoutCheckBox}"/></Border></Grid>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Спецификации" FontSize="10" HorizontalAlignment="Center"/><Grid Grid.Row="1" x:Name="ScheduleLayoutGrid" Margin="3,0,0,0"/></Grid>
</Grid>
<Border Grid.Row="2" Grid.Column="1" BorderBrush="#25202A" BorderThickness="1" Width="170" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"><Grid><Grid.RowDefinitions><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#25202A" BorderThickness="0,0,0,1"/></Grid></Border>
</Grid></Border></Border>
</StackPanel></StackPanel></Grid>
</StackPanel></TabItem></TabControl>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16"><StackPanel><TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OkButton" Content="Создать" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Click="Ok_Click" IsDefault="True"/><Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Arv.Button}" MinWidth="100" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/></StackPanel></StackPanel></Border>
</Grid></Window>