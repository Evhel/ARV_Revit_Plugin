<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ARV.ElementViews.MainWindow" Title="ARV — Создать виды элемента" Width="1180" Height="710" MinWidth="440" MinHeight="300" WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ElementViews;component/Common/ArvTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="24,16,24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Image Source="/ElementViews;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
<StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Создать виды элемента" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/><TextBlock x:Name="ContextText" Text="Настройте виды, названия и листы для выбранных элементов." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Button Content="Загрузить…" Style="{StaticResource Arv.Button}" Click="Load_Click"/><Button Content="Сохранить…" Style="{StaticResource Arv.Button}" Margin="8,0,0,0" Click="Save_Click"/></StackPanel><TextBlock x:Name="FileStatusText" Style="{StaticResource Arv.HelpText}" Margin="0,4,0,0"/></StackPanel></Grid>
<ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="24,0,24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
<CheckBox x:Name="UniqueCheckBox" VerticalAlignment="Center" Click="PreviewChanged" Margin="0,0,12,0"><TextBlock Text="Один экземпляр на заполненное значение параметра"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=UniqueCheckBox}" Value="False"><Setter Property="Foreground" Value="#8A8490"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></CheckBox>
<ComboBox Grid.Column="1" x:Name="ParameterComboBox" Style="{StaticResource Arv.ComboBox}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" IsEnabled="{Binding IsChecked,ElementName=UniqueCheckBox}" SelectionChanged="ParameterChanged" ToolTip="Введите начало названия параметра или выберите его из списка." Margin="0,0,12,0"/>
<ComboBox Grid.Column="2" x:Name="SectionTypeComboBox" Style="{StaticResource Arv.ComboBox}" ToolTip="Тип разреза"/></Grid>
<TextBlock x:Name="CountInfo" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TabControl x:Name="SettingsTabs" BorderBrush="{StaticResource Arv.Border}" Background="White"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="14,6"/><Setter Property="Foreground" Value="{StaticResource Arv.Accent}"/></Style></TabControl.Resources>
<TabItem Header="Виды"><StackPanel Margin="12">
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,8,0"><TextBlock Text="Разрезы: в стороны, мм" Style="{StaticResource Arv.FieldLabel}" TextWrapping="Wrap"/><TextBox x:Name="SideTextBox" Text="100" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Разрезы: вверх, мм" Style="{StaticResource Arv.FieldLabel}" TextWrapping="Wrap"/><TextBox x:Name="AboveTextBox" Text="100" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Разрезы: вниз, мм" Style="{StaticResource Arv.FieldLabel}" TextWrapping="Wrap"/><TextBox x:Name="BelowTextBox" Text="100" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="3"><TextBlock Text="Планы: все стороны, мм" Style="{StaticResource Arv.FieldLabel}" TextWrapping="Wrap"/><TextBox x:Name="PlanPaddingTextBox" Text="100" Style="{StaticResource Arv.TextBox}"/></StackPanel>
</Grid>
<TextBlock Text="Шаблон задаёт масштаб. № вида используется в схеме листа. Пример названия — Пм-1." Style="{StaticResource Arv.HelpText}" Margin="0,0,0,8"/>
<DataGrid x:Name="ViewsGrid" Height="236" Style="{StaticResource Arv.DataGrid}" IsReadOnly="False" RowHeight="28" ColumnHeaderHeight="38" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Resources><Style TargetType="TextBox" BasedOn="{StaticResource Arv.TextBox}"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="3,1"/><Setter Property="FontSize" Value="12"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource Arv.ComboBox}"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="3,1"/><Setter Property="FontSize" Value="12"/></Style></DataGrid.Resources><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,0"/><Setter Property="FontSize" Value="11"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></DataGrid.ColumnHeaderStyle><DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="3,0"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.CellStyle>
<DataGrid.Columns>
<DataGridTemplateColumn Header="✓" Width="28" MinWidth="28"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="№" Binding="{Binding Number}" Width="28" MinWidth="28" IsReadOnly="True"/>
<DataGridTextColumn Header="Вид" Binding="{Binding Label}" Width="68" MinWidth="68" IsReadOnly="True"/>
<DataGridTemplateColumn Header="От низа, мм" Width="72" MinWidth="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding OffsetText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPlan}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Префикс вида" Width="150" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Prefix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Суффикс вида" Width="90" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Suffix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Суффикс заголовка¹" Width="135" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding TitleSuffix,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="Заголовок на листе = введённый текст + значение параметра. Пример: Разрез Пм-1"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Шаблон вида" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Templates}" SelectedValuePath="Id" SelectedValue="{Binding TemplateId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" IsTextSearchEnabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Тип экрана" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding ViewportTypes}" SelectedValuePath="Id" SelectedValue="{Binding ViewportTypeId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" IsTextSearchEnabled="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<TextBlock Text="¹ Заголовок на листе = суффикс заголовка + значение параметра (например, Разрез Пм-1)." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding SelectedItem.Preview,ElementName=ViewsGrid}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
</StackPanel></TabItem>
<TabItem x:Name="SheetsTab" Header="Листы"><StackPanel Margin="12">
<CheckBox x:Name="CreateSheetCheckBox" Content="Создавать лист для каждого элемента" FontWeight="SemiBold"/>
<Grid x:Name="SheetPanel" IsEnabled="{Binding IsChecked,ElementName=CreateSheetCheckBox}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="550"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,20,0">
<TextBlock Text="Семейство и тип основной надписи" Style="{StaticResource Arv.FieldLabel}"/><ComboBox x:Name="TitleBlockComboBox" Style="{StaticResource Arv.ComboBox}"/>
<TextBlock Text="Префикс названия листа" Style="{StaticResource Arv.FieldLabel}" Margin="0,12,0,4"/><TextBox x:Name="SheetPrefixTextBox" Text="Элемент " Style="{StaticResource Arv.TextBox}" TextChanged="SheetNameChanged"/>
<TextBlock Text="Суффикс названия листа" Style="{StaticResource Arv.FieldLabel}" Margin="0,12,0,4"/><TextBox x:Name="SheetSuffixTextBox" Style="{StaticResource Arv.TextBox}" TextChanged="SheetNameChanged"/>
<TextBlock x:Name="SheetNamePreview" Style="{StaticResource Arv.HelpText}" Margin="0,8,0,0"/>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,8,0"><TextBlock Text="Слева, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetLeftTextBox" Text="20" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Сверху, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetTopTextBox" Text="20" Style="{StaticResource Arv.TextBox}"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Зазор видов, мм" Style="{StaticResource Arv.FieldLabel}"/><TextBox x:Name="SheetGapTextBox" Text="10" Style="{StaticResource Arv.TextBox}"/></StackPanel></Grid>
<TextBlock Text="Заголовок отображает выбранный тип экрана. Дополнительный текст на листе не создаётся." Style="{StaticResource Arv.HelpText}" Margin="0,20,0,0"/>
</StackPanel>
<StackPanel Grid.Column="1">
<CheckBox x:Name="UseLayoutCheckBox" Content="Размещать по схеме листа" Margin="0,0,0,8"/>
<StackPanel IsEnabled="{Binding IsChecked,ElementName=UseLayoutCheckBox}">
<StackPanel Orientation="Horizontal"><TextBlock Text="Строки" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LayoutRowsCombo" Width="52" SelectionChanged="LayoutSizeChanged"/><TextBlock Text="Столбцы" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="LayoutColumnsCombo" Width="52" SelectionChanged="LayoutSizeChanged"/><Button Content="Заполнить по порядку" Style="{StaticResource Arv.Button}" Click="FillLayout_Click" Margin="12,0,0,0"/></StackPanel>
<Border Background="#EEEAF2" Padding="8" Margin="0,8,0,0"><Border BorderBrush="#25202A" BorderThickness="2" Background="White" Height="210"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions>
<TextBlock Grid.Column="1" Text="{Binding Text,ElementName=SheetTopTextBox,StringFormat='↓ Сверху: {0} мм'}" Foreground="#57007F" FontSize="11" VerticalAlignment="Center"/>
<TextBlock Grid.Row="1" Text="{Binding Text,ElementName=SheetLeftTextBox,StringFormat='← Слева: {0} мм'}" Foreground="#57007F" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock>
<Border Grid.Row="1" Grid.Column="1" BorderBrush="#B597C4" BorderThickness="1,1,0,0"><Grid x:Name="LayoutGrid" Margin="3"/></Border>
<Border Grid.Row="2" Grid.Column="1" BorderBrush="#25202A" BorderThickness="1" Width="170" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"><Grid><Grid.RowDefinitions><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#25202A" BorderThickness="0,0,0,1"/><TextBlock Grid.Row="1" Text="Основная надпись" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
</Grid></Border></Border>
<TextBlock Text="№ задают порядок: один столбец — общая ось X, сверху вниз — с заданным зазором. Размеры берутся по видам и их заголовкам. Каждый вид укажите один раз. Пустые ячейки не резервируют место." Style="{StaticResource Arv.HelpText}" Margin="0,8,0,0"/>
</StackPanel></StackPanel></Grid>
<TextBlock x:Name="SheetHelp" Text="Схема показывает порядок, а не размеры. Поля слева и сверху и зазор задаются в мм; справа 20 мм, снизу 55 мм. Основная надпись условная. При выходе за лист виды сохраняют своё место по схеме." Style="{StaticResource Arv.HelpText}" Margin="0,12,0,0"/>
</StackPanel></TabItem></TabControl>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16"><StackPanel><TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OkButton" Content="Создать" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Click="Ok_Click" IsDefault="True"/><Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Arv.Button}" MinWidth="100" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/></StackPanel></StackPanel></Border>
</Grid></Window>