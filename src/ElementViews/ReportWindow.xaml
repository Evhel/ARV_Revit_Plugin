<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Class="ARV.ElementViews.ReportWindow" Title="ARV — Виды элемента — итоги" Width="780" Height="460" MinWidth="440" MinHeight="300" WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ElementViews;component/Common/ArvTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="24,24,24,16"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image Source="/ElementViews;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
<StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Виды элемента — итоги" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/><TextBlock x:Name="ContextText" Text="Настройте виды, названия и листы для выбранных элементов." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/></StackPanel></Grid>
<ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="SummaryText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
<DataGrid x:Name="SkippedGrid" RowHeight="{x:Static sys:Double.NaN}" Height="220" Style="{StaticResource Arv.DataGrid}"><DataGrid.Columns><DataGridTextColumn Header="Пропущенный элемент" Binding="{Binding Element}" Width="210" MinWidth="210"/><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*" MinWidth="240"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
<TextBlock x:Name="ReportHint" Text="Ошибка одного элемента откатывает только его комплект видов и лист. Исходные элементы не изменяются." Style="{StaticResource Arv.HelpText}" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16"><StackPanel><TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button IsCancel="True" x:Name="OkButton" Content="Закрыть" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Click="Ok_Click" IsDefault="True"/></StackPanel></StackPanel></Border>
</Grid></Window>