<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WallStartSchedule.MainWindow" Title="ARV — Черновая отделка" Width="540" Height="760" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WallStartSchedule;component/Common/ArvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/WallStartSchedule;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Черновая отделка" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContextText" Text="Выберите группу модели и типы отделки для ведомости." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,0" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="Группа модели" Target="{Binding ElementName=FilterComboBox}" Style="{StaticResource Arv.InputLabel}"/>
                                    <ComboBox x:Name="FilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="Коэффициент запаса, % (0–100)" Target="{Binding ElementName=CoefficientTextBox}" Style="{StaticResource Arv.InputLabel}"/>
                                    <TextBox x:Name="CoefficientTextBox" Text="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Типы отделки по столбцам" Style="{StaticResource Arv.SectionHeading}" Margin="0,0,0,16"/>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Столбец 1" Target="{Binding ElementName=ComboBox1}" Style="{StaticResource Arv.InputLabel}"/>
                            <ComboBox x:Name="ComboBox1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Столбец 2" Target="{Binding ElementName=ComboBox2}" Style="{StaticResource Arv.InputLabel}"/>
                            <ComboBox x:Name="ComboBox2"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Столбец 3" Target="{Binding ElementName=ComboBox3}" Style="{StaticResource Arv.InputLabel}"/>
                            <ComboBox x:Name="ComboBox3"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Столбец 4" Target="{Binding ElementName=ComboBox4}" Style="{StaticResource Arv.InputLabel}"/>
                            <ComboBox x:Name="ComboBox4"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Столбец 5" Target="{Binding ElementName=ComboBox5}" Style="{StaticResource Arv.InputLabel}"/>
                            <ComboBox x:Name="ComboBox5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="Рассчитать" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
                    <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
