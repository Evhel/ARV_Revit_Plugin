<Window x:Class="WallStartSchedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ведомость черновой отделки" 
        Height="460" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15,15,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите типы отделки для столбцов" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Группа модели:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" x:Name="FilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" Height="23"/>
        </Grid>

        <!-- Коэффициент запаса -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="Коэффициент запаса (0-100):" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" 
                     x:Name="CoefficientTextBox" 
                     Text="0" 
                     Height="23" 
                     TextAlignment="Right"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="Столбец 1:" Margin="0,0,0,3"/>
        <ComboBox Grid.Row="4" x:Name="ComboBox1" Margin="0,0,0,8" Height="23"/>

        <TextBlock Grid.Row="5" Text="Столбец 2:" Margin="0,0,0,3"/>
        <ComboBox Grid.Row="6" x:Name="ComboBox2" Margin="0,0,0,8" Height="23"/>

        <TextBlock Grid.Row="7" Text="Столбец 3:" Margin="0,0,0,3"/>
        <ComboBox Grid.Row="8" x:Name="ComboBox3" Margin="0,0,0,8" Height="23"/>

        <TextBlock Grid.Row="9" Text="Столбец 4:" Margin="0,0,0,3"/>
        <ComboBox Grid.Row="10" x:Name="ComboBox4" Margin="0,0,0,8" Height="23"/>

        <TextBlock Grid.Row="11" Text="Столбец 5:" Margin="0,0,0,3"/>
        <ComboBox Grid.Row="12" x:Name="ComboBox5" Margin="0,0,0,10" Height="23"/>

        <Grid Grid.Row="15" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="OK" Width="80" Height="26" Click="OkButton_Click" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Отмена" Width="80" Height="26" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>