<Window x:Class="CopyViewsWithRename.CopyViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Копирование видов" Height="550" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбранные виды -->
        <TextBlock Grid.Row="0" Text="Выбранные виды:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListBox Grid.Row="1" Name="ViewsListBox" Height="120" Margin="0,0,0,10" 
                 SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Параметры копирования -->
        <GroupBox Grid.Row="2" Header="Параметры копирования" Margin="0,5">
            <StackPanel Margin="10">
                <!-- Количество копий -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Количество копий:" Width="140" VerticalAlignment="Center"/>
                    <TextBox Name="CopiesTextBox" Width="80" Text="1" 
                             PreviewTextInput="NumberValidationTextBox"/>
                </StackPanel>

                <!-- Тип копирования -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                    <TextBlock Text="Тип копирования:" Width="140" VerticalAlignment="Top"/>
                    <StackPanel>
                        <RadioButton Name="DuplicateRadioButton" Content="Полная копия" 
                                     IsChecked="True" Margin="0,2"/>
                        <RadioButton Name="DuplicateWithDetailingRadioButton" 
                                     Content="Копия с детализацией" Margin="0,2"/>
                        <RadioButton Name="DuplicateAsDependentRadioButton" 
                                     Content="Зависимая копия" Margin="0,2"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Замена текста -->
        <GroupBox Grid.Row="3" Header="Замена текста в названии" Margin="0,5">
            <StackPanel Margin="10">
                <CheckBox Name="UseReplaceCheckBox" Content="Заменить слово в названии" 
                          Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,5" IsEnabled="False" Name="ReplacePanel">
                    <TextBlock Text="Найти:" Width="100" VerticalAlignment="Center"/>
                    <TextBox Name="FindTextBox" Width="200" Margin="0,0,10,0" 
                             TextChanged="FindTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5" IsEnabled="False" Name="ReplaceTextPanel">
                    <TextBlock Text="Заменить на:" Width="100" VerticalAlignment="Center"/>
                    <TextBox Name="ReplaceTextBox" Width="200" 
                             TextChanged="ReplaceTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Предпросмотр -->
        <TextBlock Grid.Row="4" Name="PreviewTextBlock" Text="Предпросмотр:" 
                   FontWeight="Bold" Margin="0,10,0,5" Visibility="Collapsed"/>
        <ListBox Grid.Row="5" Name="PreviewListBox" Height="100" Visibility="Collapsed"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Name="OkButton" Content="OK" Width="90" Height="30" 
                    Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True">
                <Button.Background>
                    <SolidColorBrush Color="#4CAF50"/>
                </Button.Background>
            </Button>
            <Button Name="CancelButton" Content="Отмена" Width="90" Height="30" 
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>