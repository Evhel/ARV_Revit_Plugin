<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CopyViewsWithRename.CopyViewsWindow" Title="ARV — Копировать виды" Width="700" Height="790" MinWidth="440" MinHeight="300" WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CopyViewsWithRename;component/Common/ArvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/CopyViewsWithRename;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Копировать виды" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContextText" Text="Обработаны будут все виды из исходного выбора." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,0" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Выбранные виды" Style="{StaticResource Arv.SectionHeading}" Margin="0,0,0,16"/>
                        <TextBlock Text="Список показывает исходный выбор Revit. Обрабатываются все перечисленные виды." Style="{StaticResource Arv.HelpText}" Margin="0,0,0,12"/>
                        <ListBox x:Name="ViewsListBox" Height="112" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Копирование" Style="{StaticResource Arv.SectionHeading}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="Копий каждого вида (1–100)" Target="{Binding ElementName=CopiesTextBox}" Style="{StaticResource Arv.InputLabel}"/>
                                    <TextBox x:Name="CopiesTextBox" Text="1" PreviewTextInput="NumberValidationTextBox"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <RadioButton x:Name="DuplicateRadioButton" Content="Полная копия" IsChecked="True"/>
                                <RadioButton x:Name="DuplicateWithDetailingRadioButton" Content="Копия с детализацией"/>
                                <RadioButton x:Name="DuplicateAsDependentRadioButton" Content="Зависимая копия"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Названия копий" Style="{StaticResource Arv.SectionHeading}" Margin="0,0,0,16"/>
                        <CheckBox x:Name="UseReplaceCheckBox" Content="Заменить текст в названии"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ReplacePanel" IsEnabled="False" Grid.Column="0">
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="Найти" Target="{Binding ElementName=FindTextBox}" Style="{StaticResource Arv.InputLabel}"/>
                                    <TextBox x:Name="FindTextBox" TextChanged="FindTextBox_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="ReplaceTextPanel" IsEnabled="False" Grid.Column="2">
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="Заменить на" Target="{Binding ElementName=ReplaceTextBox}" Style="{StaticResource Arv.InputLabel}"/>
                                    <TextBox x:Name="ReplaceTextBox" TextChanged="ReplaceTextBox_TextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PreviewTextBlock" Text="Предпросмотр названий" Style="{StaticResource Arv.SectionHeading}" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <ListBox x:Name="PreviewListBox" Height="120" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="Копировать" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
                    <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
