<Window x:Class="AdjustCropToBreakLines.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка обрезки видов" 
        Height="280" Width="560"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid Margin="10,10,10,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Отступ -->
        <GroupBox Grid.Row="0" Header="Отступ от границы" Margin="0,0,0,5" Padding="5">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Расстояние (мм):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="1" Width="80" Height="28" Text="50" TextAlignment="Center" FontSize="13"/>
                <TextBlock Grid.Column="2" Text=" (отрицательное значение сужает рамку)" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="10" Foreground="Gray"/>
            </Grid>
        </GroupBox>

        <!-- Источники границ -->
        <GroupBox Grid.Row="1" Header="Источники для определения границ" Margin="0,0,0,5" Padding="5">
            <StackPanel Margin="10,5">
                <CheckBox x:Name="UseBreakLinesCheckBox" Content="Линии обрыва (имя содержит обрыв / разрыв / break)"
                          IsChecked="True" Margin="0,3" FontSize="12"/>
                <CheckBox x:Name="UseModelElementsCheckBox" Content="Элементы модели (стены, фундамент)" 
                          IsChecked="True" Margin="0,3" FontSize="12"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Выполнить" Width="100" Height="32" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13"
                    Cursor="Hand" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="32" 
                    FontSize="13" Cursor="Hand" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>