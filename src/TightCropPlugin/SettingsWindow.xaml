<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AdjustCropToBreakLines.SettingsWindow" Title="ARV — Обрезать виды" Width="620" Height="540" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TightCropPlugin;component/Common/ArvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/TightCropPlugin;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Обрезать виды" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContextText" Text="Задайте отступ и источники границ." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,0" Focusable="False">
            <StackPanel>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Label Content="Отступ от границы, мм" Target="{Binding ElementName=OffsetTextBox}" Style="{StaticResource Arv.InputLabel}"/>
                            <TextBox x:Name="OffsetTextBox" Text="50"/>
                        </StackPanel>
                        <TextBlock Text="Отрицательное значение сужает рамку." Style="{StaticResource Arv.HelpText}" Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Источники границ" Style="{StaticResource Arv.SectionHeading}" Margin="0,0,0,16"/>
                        <CheckBox x:Name="UseBreakLinesCheckBox" IsChecked="True">
                            <TextBlock Text="Линии обрыва (обрыв / разрыв / break в имени)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="UseModelElementsCheckBox" IsChecked="True">
                            <TextBlock Text="Элементы модели: стены и фундамент" TextWrapping="Wrap"/>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="Обрезать" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
                    <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
