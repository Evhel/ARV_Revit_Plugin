<Window x:Class="PlaceViewsOnSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Размещение видов на листе" Height="450" Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбранные виды -->
        <TextBlock Grid.Row="0" Text="Выбранные виды:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListBox Grid.Row="1" Name="ViewsListBox" Height="120" Margin="0,0,0,10" DisplayMemberPath="Name"/>

        <!-- Выбор листа -->
        <TextBlock Grid.Row="2" Text="Выберите лист:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" Name="SheetsComboBox" Height="25" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SheetNumber}"/>
                        <TextBlock Text=" - "/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Настройки размещения -->
        <GroupBox Grid.Row="4" Header="Настройки размещения" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Количество видов в ряду -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Видов в ряду:" Margin="5" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="ViewsPerRowTextBox" Text="3" Margin="5" Width="60" HorizontalAlignment="Left" ToolTip="Максимальное количество видов в одной строке"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="шт." Margin="5"/>

                <!-- Шаг по X -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Шаг по X:" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="StepXTextBox" Text="300" Margin="5" Width="100" HorizontalAlignment="Left" ToolTip="Расстояние между видами по горизонтали в мм"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="мм" Margin="5"/>

                <!-- Шаг по Y -->
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Шаг по Y:" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="4" Name="StepYTextBox" Text="200" Margin="5" Width="100" HorizontalAlignment="Left" ToolTip="Расстояние между видами по вертикали в мм"/>
                <TextBlock Grid.Row="1" Grid.Column="5" Text="мм" Margin="5"/>

                <!-- Пояснение -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" 
                           Text="* Начальная позиция: 50 мм от левого и нижнего края листа" 
                           FontSize="10" Foreground="Gray" Margin="5,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="OkButton" Content="OK" Width="80" Height="30" Margin="5" Click="OkButton_Click" IsDefault="True"/>
            <Button Name="CancelButton" Content="Отмена" Width="80" Height="30" Margin="5" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>