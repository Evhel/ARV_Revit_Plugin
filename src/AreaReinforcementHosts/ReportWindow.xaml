<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ARV.AreaReinforcementHosts.ReportWindow" Title="ARV — Основы армирования" Width="880" Height="400" MinWidth="440" MinHeight="300" WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{DynamicResource Arv.DialogWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AreaReinforcementHosts;component/Common/ArvTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/AreaReinforcementHosts;component/Common/Command.png" Width="32" Height="32" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Основы армирования" Style="{StaticResource Arv.Heading}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContextText" Text="Результат смены основ армирования по площади." Style="{StaticResource Arv.HelpText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Border x:Name="SingleResult" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Arv.Border}" BorderThickness="1" Padding="16" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="SingleStatus" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SingleIds" Style="{StaticResource Arv.HelpText}" Margin="0,6,0,12"/>
                        <TextBlock x:Name="SingleDetail" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="ResultsGrid" Height="300" Style="{StaticResource Arv.DataGrid}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Старый ID" Binding="{Binding OldId}" Width="88"/>
                        <DataGridTextColumn Header="Новый ID" Binding="{Binding NewId}" Width="88"/>
                        <DataGridTextColumn Header="Основа ID" Binding="{Binding HostId}" Width="94"/>
                        <DataGridTextColumn Header="Результат" Binding="{Binding Status}" Width="126"/>
                        <DataGridTextColumn Header="Подробности" Binding="{Binding Detail}" Width="*" MinWidth="250"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="ConsequenceText" Text="При пересоздании меняется ID. Старые марки и размеры могут удалиться или потерять связь. Армирования с ошибкой оставлены без изменений." Style="{StaticResource Arv.HelpText}" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Background="White" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{StaticResource Arv.Error}" Visibility="Collapsed" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="Закрыть" Style="{StaticResource Arv.PrimaryButton}" MinWidth="128" Click="Close_Click" IsDefault="True" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
