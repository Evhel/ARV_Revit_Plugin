<Window x:Class="HideCategory.UserWindRoom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HideCategory"
             mc:Ignorable="d" 
             Title="Скрыть категорию" Height="180" Width="400" 
             WindowStartupLocation="CenterScreen"
             ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите категорию для скрытия:" Grid.Row="0" Margin="0,0,0,5" FontWeight="Bold"/>

        <ComboBox x:Name="CategoryComboBox" Grid.Row="1" Height="25" Margin="0,0,0,10" 
                  DisplayMemberPath="DisplayName" 
                  IsEditable="False"
                  IsTextSearchEnabled="True"
                  IsTextSearchCaseSensitive="False"/>

        <Button Content="Скрыть категорию" Width="150" Height="30" Grid.Row="2" 
                HorizontalAlignment="Center" Click="OnHideCategoryClick" Margin="0,0,0,10"/>

        <ProgressBar x:Name="ProgressBar" Grid.Row="3" Height="20" IsIndeterminate="True" Visibility="Collapsed"/>
    </Grid>
</Window>