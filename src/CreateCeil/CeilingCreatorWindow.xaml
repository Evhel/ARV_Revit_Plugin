<Window x:Class="CeilingPlugin.CeilingCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Построить потолки" Height="450" Width="600" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridCeilings" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ВО_СтильПотолок" 
                                    Binding="{Binding StyleName}" 
                                    Width="2*" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Тип потолка" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.CeilingTypes, 
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedCeilingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="TypeName"
                                      Margin="2" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Создать потолки" Click="BtnCreate_Click" 
                Height="35" Width="200" FontSize="14" HorizontalAlignment="Center"/>
    </Grid>
</Window>