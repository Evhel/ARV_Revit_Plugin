<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="704" Background="{DynamicResource Arv.Background}"
        BorderBrush="{DynamicResource Arv.Border}" BorderThickness="1"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="13"
        TextElement.Foreground="{DynamicResource Arv.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ArvTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Border.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="24,20,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Width="32" Height="32" VerticalAlignment="Top" Margin="0,4,8,0" Source="../../src/ARV_Ribbon/Images/ViewsToSheets.png"/>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Arv.Heading}" Text="Виды на лист"/>
                <TextBlock Style="{StaticResource Arv.HelpText}" Margin="0,4,0,0" Text="Выберите лист и задайте размещение выбранных видов."/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
            <StackPanel>
                <Border Style="{StaticResource Arv.Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{StaticResource Arv.AccentLight}" CornerRadius="4" Padding="8,2"><TextBlock Foreground="{StaticResource Arv.Accent}" Text="3 вида" FontSize="12"/></Border>
                            <TextBlock Style="{StaticResource Arv.SectionHeading}" Text="Выбранные виды"/>
                        </DockPanel>
                        <DataGrid x:Name="ViewsGrid" Style="{StaticResource Arv.DataGrid}" Height="144">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя вида" Binding="{Binding Name}" Width="400"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="120"/>
                                <DataGridTextColumn Header="На листе" Binding="{Binding OnSheet}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Arv.HelpText}" Margin="0,10,0,0" Text="Порядок: по имени вида, слева направо и сверху вниз."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Arv.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Arv.SectionHeading}" Text="Размещение" Margin="0,0,0,12"/>
                        <Label Target="{Binding ElementName=TargetSheet}" Content="Лист" Padding="0" Margin="0,0,0,6"/>
                        <ComboBox x:Name="TargetSheet" Style="{StaticResource Arv.ComboBox}" SelectedIndex="0" Margin="0,0,0,16">
                            <ComboBoxItem Content="А101 — Планы и разрезы"/>
                            <ComboBoxItem Content="А102 — Фасады"/>
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Target="{Binding ElementName=PerRow}" Content="Видов в ряду" Padding="0" Margin="0,0,0,6"/>
                                <TextBox x:Name="PerRow" Style="{StaticResource Arv.TextBox}" Text="3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Target="{Binding ElementName=StepX}" Content="Шаг по X, мм" Padding="0" Margin="0,0,0,6"/>
                                <TextBox x:Name="StepX" Style="{StaticResource Arv.TextBox}" Text="300"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Label Target="{Binding ElementName=StepY}" Content="Шаг по Y, мм" Padding="0" Margin="0,0,0,6"/>
                                <TextBox x:Name="StepY" Style="{StaticResource Arv.TextBox}" Text="200"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Arv.HelpText}" Margin="0,12,0,0" Text="Отступ — 50 мм от левого и верхнего края листа."/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Arv.HelpText}" Margin="0,12,0,0" Text="Уже размещённые и неподходящие виды будут пропущены с объяснением в результате."/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Arv.Border}" BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PlaceButton" Style="{StaticResource Arv.PrimaryButton}" Content="Разместить" MinWidth="128" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Arv.Button}" Content="Отмена"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Arv.HelpText}" VerticalAlignment="Center" Text="3 вида → 1 лист"/>
            </DockPanel>
        </Border>
    </Grid>
</Border>
